# Variables de entorno — proybetza-backend
# Copia este archivo como .env y completa los valores

# ── Servidor ──────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proybetza
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_SSL=false

# ── JWT ───────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_aleatorio_en_produccion
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────
# URL del frontend Angular (en dev suele ser localhost:4200)
CORS_ORIGIN=http://localhost:4200

# ── Upload ────────────────────────────────
MAX_FILE_SIZE_MB=5
